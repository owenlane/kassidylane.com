# Lead notifications — set these in Vercel Project Settings → Environment Variables.
# All are optional for the build; the lead API degrades gracefully if absent.

# --- Email (Resend) ---
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=kassidylane@gmail.com
LEAD_FROM_EMAIL=leads@kassidylane.net
# Legacy names still honored: LEAD_NOTIFY_TO / LEAD_NOTIFY_FROM

# --- SMS (Twilio Programmable Messaging) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LEAD_SMS_TO=+15415436880

# --- Optional lead storage (Supabase, table "leads") ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site URL (canonical/sitemap/OG) ---
NEXT_PUBLIC_SITE_URL=https://kassidylane.net
